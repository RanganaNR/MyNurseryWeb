@{
    Layout = "~/Views/Shared/_LayoutWelcome.cshtml";
    ViewData["Title"] = "MyNursery";
}

<div class="position-relative text-center" style="margin-top: 0; padding-top: 0; line-height: 1; width: 100%;">
    <img src="/assets/images/Vector.png" alt="Alternate Text" class="d-block w-100" style="margin-top: -3px; display: block; vertical-align: top;">
    <div class="position-absolute top-50 start-50 translate-middle" style="font-family: var(--main-font);">
        <h2 class="text-white mb-1" style="font-size: 2.5rem;">Gallery</h2>
    </div>
</div>

<div class="container mt-4">
    <h2 class="text-center mb-4">Our Nursery...</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <img src="~/images/nursery2.jpg" class="img-fluid" alt="Gallery Image 1">
        </div>
        <div class="col">
            <img src="~/images/nursery2.jpg" class="img-fluid" alt="Gallery Image 2">
        </div>
        <div class="col">
            <img src="~/images/nursery3.jpg" class="img-fluid" alt="Gallery Image 3">
        </div>
        <div class="col">
            <img src="~/images/nursery4.jpg" class="img-fluid" alt="Gallery Image 4">
        </div>
        <div class="col">
            <img src="image5.jpg" class="img-fluid" alt="Gallery Image 5">
        </div>
        <div class="col">
            <img src="image6.jpg" class="img-fluid" alt="Gallery Image 6">
        </div>
    </div>
    <div class="text-center mt-4">
        <a href="#" class="btn btn-warning">See More <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="mt-5 bg-light p-4 rounded">
        <div class="text-center">
            <img src="#" class="img-fluid" alt="Nursery Video">
        </div>
    </div>
</div>